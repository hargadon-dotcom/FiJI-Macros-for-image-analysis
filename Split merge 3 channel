// Split and Merge Channels - All Open Images (3-channel)
// Channel order is preserved; colors are applied as LUTs after merging

colors = newArray("Red", "Green", "Blue", "Gray", "Cyan", "Magenta", "Yellow");
Dialog.create("Channel colors");
Dialog.addChoice("Channel 1", colors, "Blue");
Dialog.addChoice("Channel 2", colors, "Green");
Dialog.addChoice("Channel 3", colors, "Red");
Dialog.show();
col = newArray(3);
col[0] = Dialog.getChoice();
col[1] = Dialog.getChoice();
col[2] = Dialog.getChoice();
if (col[0] == col[1] || col[0] == col[2] || col[1] == col[2]) exit("Pick three different colors");

titles = getList("image.titles");

if (titles.length == 0) {
    showMessage("No images open");
} else {
    for (i = 0; i < titles.length; i++) {
        title = titles[i];

        if (!isOpen(title)) continue;

        selectWindow(title);

        getDimensions(w, h, channels, slices, frames);
        if (channels != 3) {
            print("Skipping " + title + " - has " + channels + " channel(s), not 3");
            continue;
        }

        run("Split Channels");

        // The 3 split windows are the last 3 open images; match them by C1-/C2-/C3- prefix
        n = nImages;
        ct = newArray(3);
        for (j = n - 2; j <= n; j++) {
            selectImage(j);
            t = getTitle();
            if (startsWith(t, "C1-")) ct[0] = t;
            else if (startsWith(t, "C2-")) ct[1] = t;
            else if (startsWith(t, "C3-")) ct[2] = t;
        }

        print("Merging c1=" + ct[0] + "  c2=" + ct[1] + "  c3=" + ct[2]);

        // Merge in original order (slots 1-3), then recolor each channel below
        run("Merge Channels...", "c1=[" + ct[0] + "] c2=[" + ct[1] + "] c3=[" + ct[2] + "] create");
        rename(title + "_merged");

        for (c = 1; c <= 3; c++) {
            Stack.setChannel(c);
            run(lutName(col[c - 1]));
        }
        Stack.setChannel(1);
    }
}

function lutName(name) {
    if (name == "Gray") return "Grays";
    return name;
}
